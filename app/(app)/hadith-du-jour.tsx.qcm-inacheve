/**
 * Hadith du jour + QCM de compréhension.
 *
 * Le hadith est tiré de façon DÉTERMINISTE à partir de la date (voir
 * `dailyQuiz`) : il ne change pas si on quitte et revient dans la journée, et
 * il est le même pour tout le monde — ce qui permettra d'en parler entre
 * utilisateurs.
 *
 * La question porte sur le thème du hadith plutôt que sur un détail rédigé à
 * la main : c'est la seule chose qu'on puisse affirmer juste sur 7 500 hadiths
 * sans relecture humaine. Les 3 mauvaises réponses sont d'autres thèmes
 * réellement présents dans le recueil.
 *
 * Un seul quiz par jour (`recordQuiz` ignore un second appel le même jour) —
 * sinon on pourrait réessayer jusqu'à tomber juste et empocher les XP.
 */
import { useEffect, useMemo, useState } from 'react';
import {
  View, Text, Pressable, ScrollView, StyleSheet, ActivityIndicator,
  useWindowDimensions,
} from 'react-native';
import { useRouter } from 'expo-router';
import { Feather } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import HeaderPattern from '../../components/HeaderPattern';
import DeviceStatusBar from '../../components/StatusBar';
import CTAButton from '../../components/CTAButton';
import { useTheme } from '../../utils/useTheme';
import {
  loadCollection, dailyQuiz, hadithLangFor, type QuizQuestion,
} from '../../lib/hadiths';
import { useUserStore } from '../../store/userStore';
import { useHadithProgress, today } from '../../store/hadithProgressStore';
import { useT } from '../../lib/i18n';

/** XP d'une bonne réponse au quiz quotidien (≈ un tiers de leçon). */
const QUIZ_XP = 10;

/**
 * Recueil du quiz : Bukhari couvre les 9 thèmes, ce qui garantit des
 * distracteurs variés — an-Nawawi n'a qu'un chapitre et ne permet pas de QCM.
 */
const QUIZ_COLLECTION = 'bukhari' as const;

export default function HadithDuJourScreen() {
  const router = useRouter();
  const T = useTheme();
  const tr = useT();
  const { width } = useWindowDimensions();
  const hadithLang = hadithLangFor(useUserStore((s) => s.language));
  const addXP = useUserStore((s) => s.addXP);

  const markRead = useHadithProgress((s) => s.markRead);
  const recordQuiz = useHadithProgress((s) => s.recordQuiz);
  const quizStreak = useHadithProgress((s) => s.quizStreak);
  const lastQuizDay = useHadithProgress((s) => s.lastQuizDay);
  const alreadyDone = lastQuizDay === today();

  const [quiz, setQuiz] = useState<QuizQuestion | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(false);
  const [picked, setPicked] = useState<string | null>(null);
  const [checked, setChecked] = useState(false);

  const day = useMemo(() => today(), []);

  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    setError(false);
    loadCollection(QUIZ_COLLECTION, hadithLang)
      .then((c) => {
        if (cancelled) return;
        const q = dailyQuiz(c, day);
        setQuiz(q);
        // Lire le hadith du jour compte dans la progression, même sans quiz.
        if (q) markRead(QUIZ_COLLECTION, q.hadith.n);
        setLoading(false);
      })
      .catch(() => { if (!cancelled) { setError(true); setLoading(false); } });
    return () => { cancelled = true; };
  }, [hadithLang, day, markRead]);

  const correct = checked && picked === quiz?.answer;

  const onCheck = () => {
    if (!quiz || picked == null) return;
    setChecked(true);
    const ok = picked === quiz.answer;
    // `recordQuiz` est sans effet si le quiz du jour a déjà été répondu ;
    // on n'accorde donc les XP que dans le cas contraire.
    if (!alreadyDone) {
      recordQuiz(ok);
      if (ok) addXP(QUIZ_XP);
    }
  };

  return (
    <View style={[styles.screen, { backgroundColor: T.pageBg }]}>
      <DeviceStatusBar />

      <LinearGradient
        colors={['#3C8F6B', '#2E7355', '#1F5A41']}
        start={{ x: 0, y: 0 }}
        end={{ x: 1, y: 1 }}
        style={styles.header}
      >
        <HeaderPattern width={width} height={180} variant="arcs" />
        <Pressable onPress={() => router.back()} hitSlop={12} style={styles.back}>
          <Feather name="chevron-left" size={26} color="#fff" />
        </Pressable>
        <View style={styles.headerMedallion}>
          <Text style={styles.headerEmoji}>🌙</Text>
        </View>
        <Text style={styles.headerTitle}>{tr('hadiths.daily.title')}</Text>
        <View style={styles.headerRule} />
        <Text style={styles.headerSub}>
          {quizStreak > 0 ? tr('hadiths.quiz.streak', { n: quizStreak }) : tr('hadiths.daily.sub')}
        </Text>
      </LinearGradient>

      {loading ? (
        <View style={styles.stateBox}>
          <ActivityIndicator size="large" color="#2E7355" />
          <Text style={[styles.stateText, { color: T.textSecondary }]}>{tr('hadiths.loading')}</Text>
        </View>
      ) : error || !quiz ? (
        <View style={styles.stateBox}>
          <Feather name="alert-circle" size={32} color={T.textTertiary} />
          <Text style={[styles.stateText, { color: T.textSecondary }]}>
            {error ? tr('hadiths.loadError') : tr('hadiths.quiz.unavailable')}
          </Text>
        </View>
      ) : (
        <ScrollView contentContainerStyle={styles.content} showsVerticalScrollIndicator={false}>
          <View style={[styles.hadithCard, { backgroundColor: T.cardBg }]}>
            <Text style={styles.hadithNum}>{tr('hadiths.number', { n: quiz.hadith.n })}</Text>
            <Text style={[styles.hadithText, { color: T.text }]}>{quiz.hadith.t}</Text>
          </View>

          <Text style={[styles.question, { color: T.text }]}>{tr('hadiths.quiz.question')}</Text>

          {quiz.options.map((opt) => {
            const isPicked = picked === opt;
            const isAnswer = opt === quiz.answer;
            // Après validation : la bonne réponse passe en vert, le mauvais
            // choix en rouge. Avant : simple surbrillance de la sélection.
            const bg = checked
              ? isAnswer ? '#E4F7E1' : isPicked ? '#FDE7E5' : T.cardBg
              : isPicked ? '#E8E3FF' : T.cardBg;
            const border = checked
              ? isAnswer ? '#34C724' : isPicked ? '#E0584F' : T.border
              : isPicked ? '#6B4DFF' : T.border;

            return (
              <Pressable
                key={opt}
                onPress={() => !checked && setPicked(opt)}
                disabled={checked}
                style={[styles.option, { backgroundColor: bg, borderColor: border }]}
              >
                <Text style={[styles.optionText, { color: checked && (isAnswer || isPicked) ? '#1B2333' : T.text }]}>
                  {tr(`hadiths.theme.${opt}`)}
                </Text>
                {checked && isAnswer && <Feather name="check" size={18} color="#34C724" />}
                {checked && isPicked && !isAnswer && <Feather name="x" size={18} color="#E0584F" />}
              </Pressable>
            );
          })}

          {checked && (
            <View style={[styles.explainBox, { backgroundColor: correct ? '#E4F7E1' : '#FDE7E5' }]}>
              <Text style={[styles.explainTitle, { color: correct ? '#1F7A14' : '#B3312A' }]}>
                {correct ? tr('hadiths.quiz.correct') : tr('hadiths.quiz.wrong')}
                {correct && !alreadyDone ? `  ${tr('hadiths.quiz.reward', { xp: QUIZ_XP })}` : ''}
              </Text>
              <Text style={styles.explainText}>
                {tr('hadiths.quiz.explain', { chapter: quiz.chapterTitle })}
              </Text>
            </View>
          )}

          {alreadyDone && !checked && (
            <Text style={[styles.note, { color: T.textSecondary }]}>
              {tr('hadiths.daily.doneToday')}
            </Text>
          )}

          <CTAButton
            label={checked ? tr('hadiths.quiz.continue') : tr('hadiths.quiz.validate')}
            variant="green"
            disabled={!checked && picked == null}
            onPress={checked ? () => router.back() : onCheck}
            style={styles.cta}
          />

          <View style={{ height: 28 }} />
        </ScrollView>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  screen: { flex: 1 },
  header: { paddingTop: 54, paddingBottom: 22, paddingHorizontal: 20, alignItems: 'center' },
  back: { position: 'absolute', left: 14, top: 54, zIndex: 2 },
  headerMedallion: {
    width: 62, height: 62, borderRadius: 31,
    backgroundColor: 'rgba(255,255,255,0.18)',
    alignItems: 'center', justifyContent: 'center',
  },
  headerEmoji: { fontSize: 30 },
  headerTitle: {
    fontFamily: 'Baloo2_800ExtraBold', fontSize: 22, color: '#fff',
    marginTop: 10, textAlign: 'center', paddingHorizontal: 30,
  },
  headerRule: { width: 42, height: 3, borderRadius: 2, backgroundColor: 'rgba(255,255,255,0.5)', marginTop: 8 },
  headerSub: { fontFamily: 'Nunito_600SemiBold', fontSize: 13, color: 'rgba(255,255,255,0.9)', marginTop: 8 },

  content: { paddingHorizontal: 20, paddingTop: 16 },

  stateBox: { flex: 1, alignItems: 'center', justifyContent: 'center', gap: 12, paddingHorizontal: 32 },
  stateText: { fontFamily: 'Nunito_700Bold', fontSize: 15, textAlign: 'center' },

  hadithCard: {
    borderRadius: 14, padding: 16, marginBottom: 20,
    shadowColor: '#000', shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.04, shadowRadius: 8, elevation: 1,
  },
  hadithNum: { fontFamily: 'Nunito_800ExtraBold', fontSize: 11, color: '#2E7355', marginBottom: 6 },
  hadithText: { fontFamily: 'Nunito_600SemiBold', fontSize: 14, lineHeight: 22 },

  question: { fontFamily: 'Baloo2_800ExtraBold', fontSize: 17, marginBottom: 12 },
  option: {
    flexDirection: 'row', alignItems: 'center', gap: 10,
    borderRadius: 14, borderWidth: 2, paddingHorizontal: 14, paddingVertical: 14,
    marginBottom: 10,
  },
  optionText: { flex: 1, fontFamily: 'Nunito_700Bold', fontSize: 14 },

  explainBox: { borderRadius: 14, padding: 14, marginTop: 8 },
  explainTitle: { fontFamily: 'Baloo2_800ExtraBold', fontSize: 16, marginBottom: 4 },
  explainText: { fontFamily: 'Nunito_600SemiBold', fontSize: 13, lineHeight: 20, color: '#1B2333' },

  note: { fontFamily: 'Nunito_600SemiBold', fontSize: 13, textAlign: 'center', marginTop: 12 },
  cta: { marginTop: 20 },
});
