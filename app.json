{
  "expo": {
    "name": "Tarteel",
    "slug": "tarteel",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tarteel",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tarteel.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "wave",
          "orangemoney",
          "orange-money",
          "mtnmomo",
          "moovmoney",
          "freemoney",
          "wizall"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Ta position sert uniquement à calculer les heures de prière sur ton appareil. Elle n'est jamais envoyée ni partagée."
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.tarteel.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B4DFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tarteel.sn",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "queries": {
        "intent": [
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "wave"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "orange-money"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "orangemoney"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "mtnmomo"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "moovmoney"
            }
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6B4DFF"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6B4DFF"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Sun",
            "ios": "./assets/icon-sun.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground.png",
              "backgroundImage": "./assets/android-icon-background-sun.png"
            }
          },
          {
            "name": "Duo",
            "ios": "./assets/icon-duo.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground-duo.png",
              "backgroundImage": "./assets/android-icon-background-duo.png"
            }
          },
          {
            "name": "Fille",
            "ios": "./assets/icon-fille.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground-fille.png",
              "backgroundImage": "./assets/android-icon-background-fille.png"
            }
          },
          {
            "name": "Garcon",
            "ios": "./assets/icon-garcon.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground-garcon.png",
              "backgroundImage": "./assets/android-icon-background-garcon.png"
            }
          }
        ]
      ],
      [
        "expo-widget",
        {
          "ios": {
            "src": "./widgets/ios/TarteelWidgets",
            "appGroupIdentifier": "group.com.tarteel.app",
            "devTeam": "XJ6GTF5K9C"
          },
          "android": {
            "src": "./widgets/android",
            "widgets": [
              {
                "name": "StreakWidgetProvider",
                "resourceName": "@xml/w_streak_info"
              },
              {
                "name": "ContinueWidgetProvider",
                "resourceName": "@xml/w_continue_info"
              },
              {
                "name": "WeekWidgetProvider",
                "resourceName": "@xml/w_week_info"
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cff220aa-194a-4aa9-8133-09d153db68d1"
      }
    },
    "owner": "medouness-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cff220aa-194a-4aa9-8133-09d153db68d1"
    }
  }
}
