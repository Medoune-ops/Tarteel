{
  "expo": {
    "name": "Tarteel",
    "slug": "tarteel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tarteel",
    "splash": {
      "backgroundColor": "#6B4DFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tarteel.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "LSApplicationQueriesSchemes": [
          "wave",
          "orangemoney",
          "orange-money",
          "mtnmomo",
          "moovmoney",
          "freemoney",
          "wizall"
        ]
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.tarteel.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B4DFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tarteel.app",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "queries": {
        "intent": [
          { "action": "android.intent.action.VIEW", "data": { "scheme": "wave" } },
          { "action": "android.intent.action.VIEW", "data": { "scheme": "orange-money" } },
          { "action": "android.intent.action.VIEW", "data": { "scheme": "orangemoney" } },
          { "action": "android.intent.action.VIEW", "data": { "scheme": "mtnmomo" } },
          { "action": "android.intent.action.VIEW", "data": { "scheme": "moovmoney" } }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6B4DFF"
        }
      ],
      "expo-asset"
    ],
    "_widgetPlugin_activateForEASBuild": [
      "expo-widget",
      {
        "ios": {
          "src": "./widgets/ios/TarteelWidgets",
          "appGroupIdentifier": "group.com.tarteel.app",
          "devTeam": "XXXXXXXXXX"
        }
      }
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
