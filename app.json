{
  "expo": {
    "name": "Tarteel",
    "slug": "tarteel",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tarteel",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tarteel.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "wave",
          "orangemoney",
          "orange-money",
          "mtnmomo",
          "moovmoney",
          "freemoney",
          "wizall"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Ta position sert uniquement à calculer les heures de prière sur ton appareil. Elle n'est jamais envoyée ni partagée."
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.tarteel.app.expowidgets"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B4DFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tarteel.sn",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "queries": {
        "intent": [
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "wave"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "orange-money"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "orangemoney"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "mtnmomo"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "moovmoney"
            }
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6B4DFF"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6B4DFF",
          "android": {
            "image": "./assets/android-icon-foreground.png",
            "imageWidth": 180,
            "resizeMode": "contain",
            "backgroundColor": "#6B4DFF"
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Sun",
            "ios": "./assets/icon-sun.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground.png",
              "backgroundImage": "./assets/android-icon-background-sun.png"
            }
          },
          {
            "name": "Duo",
            "ios": "./assets/icon-duo.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground-duo.png",
              "backgroundImage": "./assets/android-icon-background-duo.png"
            }
          },
          {
            "name": "Fille",
            "ios": "./assets/icon-fille.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground-fille.png",
              "backgroundImage": "./assets/android-icon-background-fille.png"
            }
          },
          {
            "name": "Garcon",
            "ios": "./assets/icon-garcon.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground-garcon.png",
              "backgroundImage": "./assets/android-icon-background-garcon.png"
            }
          }
        ]
      ],
      [
        "expo-widget",
        {
          "ios": {
            "src": "./widgets/ios/TarteelWidgets",
            "appGroupIdentifier": "group.com.tarteel.app.expowidgets",
            "devTeam": "XJ6GTF5K9C",
            "xcode": {
              "configOverrides": {
                "SWIFT_VERSION": "5.0",
                "IPHONEOS_DEPLOYMENT_TARGET": "17.0"
              }
            }
          },
          "android": {
            "src": "./widgets/android",
            "widgets": [
              {
                "name": "StreakWidgetProvider",
                "resourceName": "@xml/w_streak_info"
              },
              {
                "name": "ContinueWidgetProvider",
                "resourceName": "@xml/w_continue_info"
              },
              {
                "name": "WeekWidgetProvider",
                "resourceName": "@xml/w_week_info"
              },
              {
                "name": "WordOfDayWidgetProvider",
                "resourceName": "@xml/w_wordofday_info"
              }
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Regles de protection contre l'obfuscation R8.\n# Google Play signalait un taux d'obscurcissement de 1 % : R8 etait desactive\n# par defaut. En l'activant, il faut proteger tout ce qui est resolu par\n# REFLEXION au runtime — R8 ne voit pas ces usages et renommerait/supprimerait\n# les classes concernees, ce qui ne casse QUE le build release.\n\n# React Native : ponts JNI et modules natifs resolus par nom.\n-keep,includedescriptorclasses class com.facebook.react.bridge.** { *; }\n-keep,includedescriptorclasses class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keepclassmembers class * { @com.facebook.react.bridge.ReactMethod <methods>; }\n-keepclassmembers class * { @com.facebook.proguard.annotations.DoNotStrip *; }\n-keep @com.facebook.proguard.annotations.DoNotStrip class * { *; }\n\n# Hermes.\n-keep class com.facebook.hermes.** { *; }\n\n# Modules Expo : instancies par nom depuis le registre de modules.\n-keep class expo.modules.** { *; }\n-keep class * implements expo.modules.core.interfaces.Package { *; }\n\n# react-native-track-player : service de lecture audio declare dans le\n# manifeste et resolu par nom — s'il est renomme, l'audio ne demarre plus.\n-keep class com.doublesymmetry.trackplayer.** { *; }\n-keep class com.google.android.exoplayer2.** { *; }\n-dontwarn com.google.android.exoplayer2.**\n\n# Widgets Tarteel : les AppWidgetProvider sont references par nom dans le\n# manifeste (voir app.json -> expo-widget -> android.widgets).\n-keep class com.tarteel.sn.** { *; }\n\n# JSON : les modeles serialises/deserialises perdraient leurs noms de champs.\n-keepclassmembers class * { @com.google.gson.annotations.SerializedName <fields>; }\n-keepattributes Signature,*Annotation*,InnerClasses,EnclosingMethod\n\n# OkHttp / Okio (reseau).\n-dontwarn okhttp3.**\n-dontwarn okio.**\n-dontwarn javax.annotation.**\n\n# Libs natives sans regles ProGuard propres (verifie : elles n en fournissent\n# aucune via consumerProguardFiles, contrairement a expo/reanimated/svg).\n# async-storage porte TOUTE la persistance Zustand (session, streak, prefs) :\n# une classe elaguee ici se traduirait par une perte de donnees silencieuse.\n-keep class com.reactnativecommunity.asyncstorage.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.reactnativecommunity.webview.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cff220aa-194a-4aa9-8133-09d153db68d1"
      }
    },
    "owner": "medouness-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cff220aa-194a-4aa9-8133-09d153db68d1"
    }
  }
}
