{
  "expo": {
    "name": "Tarteel",
    "slug": "tarteel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tarteel",
    "splash": {
      "backgroundColor": "#6B4DFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tarteel.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "wave",
          "orangemoney",
          "orange-money",
          "mtnmomo",
          "moovmoney",
          "freemoney",
          "wizall"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.tarteel.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B4DFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tarteel.app",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "queries": {
        "intent": [
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "wave"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "orange-money"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "orangemoney"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "mtnmomo"
            }
          },
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "moovmoney"
            }
          }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6B4DFF"
        }
      ],
      "expo-asset",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Sun",
            "ios": "./assets/icon-sun.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground.png",
              "backgroundImage": "./assets/android-icon-background-sun.png"
            }
          }
        ]
      ]
    ],
    "_widgetPlugin_activateForEASBuild": [
      "expo-widget",
      {
        "ios": {
          "src": "./widgets/ios/TarteelWidgets",
          "appGroupIdentifier": "group.com.tarteel.app",
          "devTeam": "XXXXXXXXXX"
        }
      }
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cff220aa-194a-4aa9-8133-09d153db68d1"
      }
    },
    "owner": "medouness-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cff220aa-194a-4aa9-8133-09d153db68d1"
    }
  }
}
