<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Rappel (2×2) — équivalent Android de ContinueSmallWidget.swift.
  Heure de rappel + message d'incitation. Le widget entier ouvre l'app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_continue_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_bg_continue"
    android:padding="16dp">

    <!-- Ligne du haut : "Rappel" + heure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/w_reminder_label"
            android:textColor="@color/w_white"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_reminder_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21:00"
            android:textColor="@color/w_white_70"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/w_reminder_message"
        android:textColor="@color/w_white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Pied : "3 min suffisent" -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/w_pill_light"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/w_reminder_duration"
        android:textColor="@color/w_white"
        android:textSize="12.5sp"
        android:textStyle="bold" />
</LinearLayout>
