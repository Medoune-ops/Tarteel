<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Rappel (2×2) — calqué sur l'aperçu de l'app (app/(app)/widgets.tsx,
  composant ContinuePreview), et NON sur la version iOS.

  L'aperçu pose deux icônes que la version iOS tirait de SF Symbols
  (bell.fill, clock.fill) : sur Android, on utilise les emoji correspondantes,
  une RemoteViews ne pouvant pas composer d'icône vectorielle dans un TextView.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_continue_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_bg_continue"
    android:padding="16dp">

    <!-- Ligne du haut : « 🔔 Rappel » + heure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="🔔"
            android:textSize="11sp"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/w_reminder_label"
            android:textColor="@color/w_white"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_reminder_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21:00"
            android:textColor="@color/w_white_70"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Mascotte + message, côte à côte (contMessageRow). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/w_continue_otter"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="9dp"
            android:src="@drawable/w_otter"
            android:contentDescription="@string/w_otter_desc" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/w_reminder_message"
            android:textColor="@color/w_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Pied : « ⏰ 3 min suffisent » -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/w_pill_light"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:text="⏰"
            android:textSize="12sp"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/w_reminder_duration"
            android:textColor="@color/w_white"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
