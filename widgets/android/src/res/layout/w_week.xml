<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Ma semaine (4×2) — équivalent Android de WeekMediumWidget.swift.
  Deux colonnes : la série à gauche sur fond orange, la semaine à droite
  sur panneau clair.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- ── Colonne gauche : la série ── -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/w_bg_streak"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/w_week_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/w_white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/w_streak_unit"
            android:textColor="@color/w_white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Colonne droite : la semaine ── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/w_bg_panel"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Titre + XP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/w_week_title"
                android:textColor="@color/w_text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/w_week_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/w_pill_purple"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="0 XP"
                android:textColor="@color/w_purple"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Les 7 jours -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_wd0" style="@style/WWeekDot" />
                <TextView android:id="@+id/w_wl0" style="@style/WWeekLabel" android:text="@string/w_day_mon" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_wd1" style="@style/WWeekDot" />
                <TextView android:id="@+id/w_wl1" style="@style/WWeekLabel" android:text="@string/w_day_tue" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_wd2" style="@style/WWeekDot" />
                <TextView android:id="@+id/w_wl2" style="@style/WWeekLabel" android:text="@string/w_day_wed" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_wd3" style="@style/WWeekDot" />
                <TextView android:id="@+id/w_wl3" style="@style/WWeekLabel" android:text="@string/w_day_thu" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_wd4" style="@style/WWeekDot" />
                <TextView android:id="@+id/w_wl4" style="@style/WWeekLabel" android:text="@string/w_day_fri" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_wd5" style="@style/WWeekDot" />
                <TextView android:id="@+id/w_wl5" style="@style/WWeekLabel" android:text="@string/w_day_sat" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_wd6" style="@style/WWeekDot" />
                <TextView android:id="@+id/w_wl6" style="@style/WWeekLabel" android:text="@string/w_day_sun" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Message de motivation -->
        <TextView
            android:id="@+id/w_motivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/w_motivation_bg"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="@color/w_motivation_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
