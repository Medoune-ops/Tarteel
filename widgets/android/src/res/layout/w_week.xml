<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Ma semaine (4×2) — calque sur l'aperçu de l'app (app/(app)/widgets.tsx,
  composant WeekPreview), et NON sur la version iOS : c'est cet aperçu qui fait
  foi pour le rendu Android.

  Deux écarts imposés par les RemoteViews, qui ne savent ni dessiner librement
  ni redimensionner une vue en pourcentage avant l'API 31 (minSdk=24 ici) :

  1. La ligne qui relie les 7 jours est découpée en 6 segments fixes, montrés
     ou masqués un par un depuis le Kotlin, au lieu d'une barre unique dont on
     ferait varier la largeur.
  2. Les pastilles des jours sont des TextView (forme en fond + emoji au
     centre) et non des ImageView : une RemoteViews peut changer le fond ET le
     texte d'un TextView, ce qui permet de poser 🔥 ou ▶ dans le cercle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- ── Colonne gauche : la série, sur dégradé orange ── -->
    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:background="@drawable/w_bg_streak">

        <!-- Grosse flamme fantôme en bas à droite (comme weekGhostFlame). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:alpha="0.2"
            android:text="🔥"
            android:textSize="76sp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <!-- La mascotte, absente jusqu'ici côté Android. -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/w_otter"
                android:contentDescription="@string/w_otter_desc" />

            <TextView
                android:id="@+id/w_week_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/w_white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/w_streak_unit"
                android:textColor="@color/w_white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- ── Colonne droite : la semaine, sur panneau clair ── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/w_bg_panel"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="13dp"
        android:paddingBottom="12dp">

        <!-- Titre + pilule XP (avec l'éclair de l'aperçu). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/w_week_title"
                android:textColor="@color/w_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/w_week_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/w_pill_purple"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="⚡ 0 XP"
                android:textColor="@color/w_purple"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- La ligne de liaison, DERRIERE les pastilles : 6 segments entre les
             7 jours, chacun montré en orange ou en gris depuis le Kotlin. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="17dp"
                android:paddingEnd="17dp">

                <!-- FrameLayout et NON View : la balise <View> n'est pas
                     supportée par les RemoteViews et fait échouer tout le
                     widget avec « Impossible de charger » (cf. commit
                     7f03bbb, qui avait déjà corrigé 9 occurrences). -->
                <FrameLayout android:id="@+id/w_wline0" style="@style/WWeekLine" />
                <FrameLayout android:id="@+id/w_wline1" style="@style/WWeekLine" />
                <FrameLayout android:id="@+id/w_wline2" style="@style/WWeekLine" />
                <FrameLayout android:id="@+id/w_wline3" style="@style/WWeekLine" />
                <FrameLayout android:id="@+id/w_wline4" style="@style/WWeekLine" />
                <FrameLayout android:id="@+id/w_wline5" style="@style/WWeekLine" />
            </LinearLayout>

            <!-- Les 7 pastilles, par-dessus la ligne. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/WDayCol">
                    <TextView android:id="@+id/w_wd0" style="@style/WWeekDot" />
                </LinearLayout>
                <LinearLayout style="@style/WDayCol">
                    <TextView android:id="@+id/w_wd1" style="@style/WWeekDot" />
                </LinearLayout>
                <LinearLayout style="@style/WDayCol">
                    <TextView android:id="@+id/w_wd2" style="@style/WWeekDot" />
                </LinearLayout>
                <LinearLayout style="@style/WDayCol">
                    <TextView android:id="@+id/w_wd3" style="@style/WWeekDot" />
                </LinearLayout>
                <LinearLayout style="@style/WDayCol">
                    <TextView android:id="@+id/w_wd4" style="@style/WWeekDot" />
                </LinearLayout>
                <LinearLayout style="@style/WDayCol">
                    <TextView android:id="@+id/w_wd5" style="@style/WWeekDot" />
                </LinearLayout>
                <LinearLayout style="@style/WDayCol">
                    <TextView android:id="@+id/w_wd6" style="@style/WWeekDot" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Lettres des jours, sous les pastilles. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/w_wl0" style="@style/WWeekLabel" android:text="@string/w_day_mon" />
            <TextView android:id="@+id/w_wl1" style="@style/WWeekLabel" android:text="@string/w_day_tue" />
            <TextView android:id="@+id/w_wl2" style="@style/WWeekLabel" android:text="@string/w_day_wed" />
            <TextView android:id="@+id/w_wl3" style="@style/WWeekLabel" android:text="@string/w_day_thu" />
            <TextView android:id="@+id/w_wl4" style="@style/WWeekLabel" android:text="@string/w_day_fri" />
            <TextView android:id="@+id/w_wl5" style="@style/WWeekLabel" android:text="@string/w_day_sat" />
            <TextView android:id="@+id/w_wl6" style="@style/WWeekLabel" android:text="@string/w_day_sun" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Message de motivation, précédé de la flamme (comme l'aperçu). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/w_motivation_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="🔥"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/w_motivation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/w_motivation_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
