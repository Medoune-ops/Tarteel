<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Série (2×2) — équivalent Android de StreakSmallWidget.swift.
  Les 7 pastilles de la semaine sont des vues fixes : un widget Android ne
  peut pas générer de vues en boucle, chacune est donc adressée par son id
  depuis le Kotlin (w_d0 … w_d6).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_bg_streak"
    android:padding="16dp">

    <!-- Libellé « Série » -->
    <TextView
        android:id="@+id/w_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/w_streak_label"
        android:textColor="@color/w_white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Nombre de jours, en grand -->
    <TextView
        android:id="@+id/w_streak_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0"
        android:textColor="@color/w_white"
        android:textSize="52sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_streak_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/w_streak_unit"
        android:textColor="@color/w_white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Espace souple : pousse les pastilles vers le bas -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Pastilles des 7 jours -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout style="@style/WDayCol">
            <ImageView android:id="@+id/w_d0" style="@style/WDot" />
            <TextView android:id="@+id/w_l0" style="@style/WDayLabel" android:text="@string/w_day_mon" />
        </LinearLayout>
        <LinearLayout style="@style/WDayCol">
            <ImageView android:id="@+id/w_d1" style="@style/WDot" />
            <TextView android:id="@+id/w_l1" style="@style/WDayLabel" android:text="@string/w_day_tue" />
        </LinearLayout>
        <LinearLayout style="@style/WDayCol">
            <ImageView android:id="@+id/w_d2" style="@style/WDot" />
            <TextView android:id="@+id/w_l2" style="@style/WDayLabel" android:text="@string/w_day_wed" />
        </LinearLayout>
        <LinearLayout style="@style/WDayCol">
            <ImageView android:id="@+id/w_d3" style="@style/WDot" />
            <TextView android:id="@+id/w_l3" style="@style/WDayLabel" android:text="@string/w_day_thu" />
        </LinearLayout>
        <LinearLayout style="@style/WDayCol">
            <ImageView android:id="@+id/w_d4" style="@style/WDot" />
            <TextView android:id="@+id/w_l4" style="@style/WDayLabel" android:text="@string/w_day_fri" />
        </LinearLayout>
        <LinearLayout style="@style/WDayCol">
            <ImageView android:id="@+id/w_d5" style="@style/WDot" />
            <TextView android:id="@+id/w_l5" style="@style/WDayLabel" android:text="@string/w_day_sat" />
        </LinearLayout>
        <LinearLayout style="@style/WDayCol">
            <ImageView android:id="@+id/w_d6" style="@style/WDot" />
            <TextView android:id="@+id/w_l6" style="@style/WDayLabel" android:text="@string/w_day_sun" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
