<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Série (2×2) — calqué sur l'aperçu de l'app (app/(app)/widgets.tsx,
  composant StreakPreview), et NON sur la version iOS : c'est cet aperçu qui
  fait foi pour le rendu Android.

  Les 7 pastilles sont des vues fixes : une RemoteViews ne peut pas générer de
  vues en boucle, chacune est donc adressée par son id depuis le Kotlin
  (w_d0 … w_d6), de même que les lettres (w_l0 … w_l6) dont la couleur change
  pour aujourd'hui.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg_streak">

    <!-- Grosse flamme fantôme en bas à droite (streakGhostFlame). -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:alpha="0.18"
        android:text="🔥"
        android:textSize="104sp"
        android:includeFontPadding="false" />

    <!-- La mascotte, en haut à droite (streakOtterWrap). -->
    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/w_otter"
        android:contentDescription="@string/w_otter_desc" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Libellé « 🔥 Série » (la flamme fait partie de la chaîne) -->
        <TextView
            android:id="@+id/w_streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/w_streak_label"
            android:textColor="@color/w_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Espace souple : le nombre est centré verticalement comme l'aperçu -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Nombre de jours, en grand -->
        <TextView
            android:id="@+id/w_streak_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/w_white"
            android:textSize="52sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/w_streak_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/w_streak_unit"
            android:textColor="@color/w_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- XP cumulés, en pilule translucide (absents jusqu'ici de ce widget,
             alors que le widget Semaine les affichait déjà). -->
        <TextView
            android:id="@+id/w_streak_xp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/w_pill_light"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="⚡ 0 XP"
            android:textColor="@color/w_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Pastilles des 7 jours -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_d0" style="@style/WDot" />
                <TextView android:id="@+id/w_l0" style="@style/WDayLabel" android:text="@string/w_day_mon" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_d1" style="@style/WDot" />
                <TextView android:id="@+id/w_l1" style="@style/WDayLabel" android:text="@string/w_day_tue" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_d2" style="@style/WDot" />
                <TextView android:id="@+id/w_l2" style="@style/WDayLabel" android:text="@string/w_day_wed" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_d3" style="@style/WDot" />
                <TextView android:id="@+id/w_l3" style="@style/WDayLabel" android:text="@string/w_day_thu" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_d4" style="@style/WDot" />
                <TextView android:id="@+id/w_l4" style="@style/WDayLabel" android:text="@string/w_day_fri" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_d5" style="@style/WDot" />
                <TextView android:id="@+id/w_l5" style="@style/WDayLabel" android:text="@string/w_day_sat" />
            </LinearLayout>
            <LinearLayout style="@style/WDayCol">
                <ImageView android:id="@+id/w_d6" style="@style/WDot" />
                <TextView android:id="@+id/w_l6" style="@style/WDayLabel" android:text="@string/w_day_sun" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
