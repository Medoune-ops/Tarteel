<?xml version="1.0" encoding="utf-8"?>
<!-- Petit · Prochaine prière (2×2) — maquette « Tarteel Widgets Priere ». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_pn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_p_bg_hero"
    android:padding="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/w_p_next"
            android:textColor="@color/w_white_70"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/w_pn_arabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الظهر"
            android:textColor="@color/w_white"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_pn_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Dhuhr"
        android:textColor="@color/w_white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/w_pn_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:55"
        android:textColor="@color/w_white"
        android:textSize="40sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Chronometer
            android:id="@+id/w_pn_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/w_pill_light"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/w_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_pn_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dakar"
            android:textColor="@color/w_white_70"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
