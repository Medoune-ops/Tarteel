<?xml version="1.0" encoding="utf-8"?>
<!--
  APERÇU du widget Ma semaine, pour le sélecteur de widgets du lanceur.

  Pourquoi un layout séparé : dans le sélecteur, AUCUN code Kotlin ne tourne —
  Android inflate le XML tel quel. Or tout le contenu du widget réel est posé
  par WeekWidgetProvider (les 🔥 des jours faits, le ▶ d'aujourd'hui, la ligne
  orange, le message de motivation). Pointer previewLayout sur le layout réel
  donnait donc une carte vide : des pastilles grises, aucune ligne, aucun texte.

  Ce fichier reprend la même structure avec des valeurs d'exemple écrites en
  dur. Il n'est JAMAIS affiché sur l'écran d'accueil : le widget posé utilise
  w_week.xml et ses vraies données.

  À garder aligné sur w_week.xml en cas de changement de mise en page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- ── Colonne gauche : la série ── -->
    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:background="@drawable/w_bg_streak">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:alpha="0.2"
            android:text="🔥"
            android:textSize="76sp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/w_otter"
                android:contentDescription="@string/w_otter_desc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7"
                android:textColor="@color/w_white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/w_streak_unit"
                android:textColor="@color/w_white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- ── Colonne droite : la semaine ── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/w_bg_panel"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="13dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/w_week_title"
                android:textColor="@color/w_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/w_pill_purple"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="⚡ 1250 XP"
                android:textColor="@color/w_purple"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Ligne + pastilles : ici en dur, 5 jours faits puis aujourd'hui. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="34dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="17dp"
                android:paddingEnd="17dp">

                <FrameLayout style="@style/WWeekLine" android:background="@drawable/w_week_line_done" />
                <FrameLayout style="@style/WWeekLine" android:background="@drawable/w_week_line_done" />
                <FrameLayout style="@style/WWeekLine" android:background="@drawable/w_week_line_done" />
                <FrameLayout style="@style/WWeekLine" android:background="@drawable/w_week_line_done" />
                <FrameLayout style="@style/WWeekLine" android:background="@drawable/w_week_line_done" />
                <FrameLayout style="@style/WWeekLine" android:background="@drawable/w_week_line_todo" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView style="@style/WWeekDotCell" android:background="@drawable/w_dot_week_active" android:text="🔥" />
                <TextView style="@style/WWeekDotCell" android:background="@drawable/w_dot_week_active" android:text="🔥" />
                <TextView style="@style/WWeekDotCell" android:background="@drawable/w_dot_week_active" android:text="🔥" />
                <TextView style="@style/WWeekDotCell" android:background="@drawable/w_dot_week_active" android:text="🔥" />
                <TextView style="@style/WWeekDotCell" android:background="@drawable/w_dot_week_active" android:text="🔥" />
                <TextView style="@style/WWeekDotCell" android:background="@drawable/w_dot_week_today" android:text="▶" android:textColor="@color/w_purple" />
                <TextView style="@style/WWeekDotCell" android:background="@drawable/w_dot_week_idle" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/WWeekLabel" android:text="@string/w_day_mon" />
            <TextView style="@style/WWeekLabel" android:text="@string/w_day_tue" />
            <TextView style="@style/WWeekLabel" android:text="@string/w_day_wed" />
            <TextView style="@style/WWeekLabel" android:text="@string/w_day_thu" />
            <TextView style="@style/WWeekLabel" android:text="@string/w_day_fri" />
            <TextView style="@style/WWeekLabel" android:text="@string/w_day_sat" android:textColor="@color/w_purple" />
            <TextView style="@style/WWeekLabel" android:text="@string/w_day_sun" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/w_motivation_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="🔥"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/w_preview_motivation"
                android:textColor="@color/w_motivation_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
