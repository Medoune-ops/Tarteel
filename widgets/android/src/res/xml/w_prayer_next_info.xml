<?xml version="1.0" encoding="utf-8"?>
<!-- Prochaine prière : 2x2. Pas de rafraîchissement périodique (updatePeriodMillis=0) :
     PrayerWidgetBase programme lui-même un réveil à la prochaine prière. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/w_prayer_next"
    android:description="@string/w_desc_p_next"
    android:previewLayout="@layout/w_prayer_next"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
