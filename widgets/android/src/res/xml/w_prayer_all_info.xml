<?xml version="1.0" encoding="utf-8"?>
<!-- Toutes les prières : 4x2. Pas de rafraîchissement périodique (updatePeriodMillis=0) :
     PrayerWidgetBase programme lui-même un réveil à la prochaine prière. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="280dp"
    android:minHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/w_prayer_all"
    android:description="@string/w_desc_p_all"
    android:previewLayout="@layout/w_prayer_all"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
