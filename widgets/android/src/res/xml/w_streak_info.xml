<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Série : 2x2. Réveil toutes les 30 min (le minimum Android) : sans
     l'app, c'est le seul moyen de voir la flamme s'éteindre (FlameState.kt). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/w_streak"
    android:description="@string/w_desc_streak"
    android:previewLayout="@layout/w_streak"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
