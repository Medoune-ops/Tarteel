<?xml version="1.0" encoding="utf-8"?>
<!-- Barre de progression de la leçon : piste translucide + remplissage vert. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/w_white_22" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <gradient android:type="linear" android:angle="0"
                    android:startColor="@color/w_green_start" android:endColor="@color/w_green_end" />
            </shape>
        </clip>
    </item>
</layer-list>
