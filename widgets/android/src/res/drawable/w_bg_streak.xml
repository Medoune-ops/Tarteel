<?xml version="1.0" encoding="utf-8"?>
<!-- Fond du widget Série : dégradé orange en diagonale, coins arrondis. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:type="linear"
        android:angle="225"
        android:startColor="@color/w_streak_start"
        android:centerColor="@color/w_streak_mid"
        android:endColor="@color/w_streak_end" />
</shape>
